<Window x:Class="MediaFlyout.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Media Flyout"
        Width="360" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        Background="Transparent"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI"
        Foreground="{DynamicResource TextPrimary}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="-1" ResizeBorderThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PressedBrush}" />
                                <Setter Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderPart" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                            <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                    Background="{TemplateBinding Background}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FluentThumb" TargetType="Thumb">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Width="20" Height="20" Background="Transparent">
                            <Ellipse Fill="{DynamicResource ThumbOuter}" Stroke="{DynamicResource ThumbBorder}" StrokeThickness="1" />
                            <Ellipse Width="12" Height="12" Fill="{DynamicResource AccentBrush}" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="InnerScale" ScaleX="0.86" ScaleY="0.86" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="InnerScale" Storyboard.TargetProperty="ScaleX" To="1.08" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="InnerScale" Storyboard.TargetProperty="ScaleY" To="1.08" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="InnerScale" Storyboard.TargetProperty="ScaleX" To="0.86" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="InnerScale" Storyboard.TargetProperty="ScaleY" To="0.86" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FluentSlider" TargetType="Slider">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="SmallChange" Value="1" />
            <Setter Property="LargeChange" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Track x:Name="PART_Track" Height="24"
                               Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderPart}" Background="{DynamicResource AccentBrush}"
                                              Command="{x:Static Slider.DecreaseLarge}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderPart}" Background="{DynamicResource TrackBrush}"
                                              Command="{x:Static Slider.IncreaseLarge}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource FluentThumb}" />
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Margin="14,14,14,10">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="RootTranslate" />
        </Grid.RenderTransform>

        <StackPanel>
            <!-- Now playing -->
            <StackPanel x:Name="MediaSection">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="72" Height="72" Background="Transparent" Cursor="Hand"
                          MouseLeftButtonUp="Source_Click">
                        <Border CornerRadius="6" Background="{DynamicResource SubtleBrush}">
                            <TextBlock Text="&#xEC4F;" FontFamily="{StaticResource IconFont}" FontSize="26"
                                       Foreground="{DynamicResource TextSecondary}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="ArtImage" CornerRadius="6" Visibility="Collapsed">
                            <Border.Background>
                                <ImageBrush x:Name="ArtBrush" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                                Background="Transparent" Cursor="Hand" MouseLeftButtonUp="Source_Click">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <Image x:Name="AppIcon" Width="14" Height="14" Margin="0,0,6,0"
                                   RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                            <TextBlock x:Name="AppNameText" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ArtistText" FontSize="13" Margin="0,1,0,0"
                                   Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="TimelinePanel" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PositionText" FontSize="11" MinWidth="30" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondary}" Typography.NumeralAlignment="Tabular" />
                    <Grid x:Name="ProgressHost" Grid.Column="1" Height="16" Margin="8,0" Background="Transparent"
                          MouseLeftButtonDown="Progress_MouseDown" SizeChanged="ProgressHost_SizeChanged">
                        <Border Height="4" CornerRadius="2" VerticalAlignment="Center" Background="{DynamicResource TrackBrush}" />
                        <Border x:Name="ProgressFill" Height="4" CornerRadius="2" Width="0"
                                HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource AccentBrush}" />
                    </Grid>
                    <TextBlock x:Name="DurationText" Grid.Column="2" FontSize="11" MinWidth="30" TextAlignment="Right"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"
                               Typography.NumeralAlignment="Tabular" />
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                    <Button x:Name="PrevButton" Style="{StaticResource IconButton}" Content="&#xE892;" Click="Prev_Click" />
                    <Button x:Name="PlayPauseButton" Style="{StaticResource IconButton}" Content="&#xE768;"
                            Width="48" Height="40" FontSize="20" Margin="10,0" Click="PlayPause_Click" />
                    <Button x:Name="NextButton" Style="{StaticResource IconButton}" Content="&#xE893;" Click="Next_Click" />
                </StackPanel>

                <Border Height="1" Margin="-14,10,-14,8" Background="{DynamicResource DividerBrush}" />
            </StackPanel>

            <!-- Volume -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="MuteButton" Style="{StaticResource IconButton}" Content="&#xE995;"
                        Width="36" Height="32" Click="Mute_Click" />
                <Slider x:Name="VolumeSlider" Grid.Column="1" Style="{StaticResource FluentSlider}"
                        Margin="6,0,10,0" VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged" />
                <TextBlock x:Name="VolumeText" Grid.Column="2" FontSize="13" Width="28" TextAlignment="Right"
                           VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
            </Grid>
        </StackPanel>
    </Grid>
</Window>
